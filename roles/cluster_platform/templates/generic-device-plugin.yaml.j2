# Exposes host devices as schedulable resources so Frigate needs no `privileged: true`.
apiVersion: apps/v1
kind: DaemonSet
metadata:
  name: generic-device-plugin
  namespace: kube-system
  labels:
    app.kubernetes.io/name: generic-device-plugin
spec:
  selector:
    matchLabels:
      app.kubernetes.io/name: generic-device-plugin
  template:
    metadata:
      labels:
        app.kubernetes.io/name: generic-device-plugin
    spec:
      automountServiceAccountToken: false
      priorityClassName: system-node-critical
      tolerations:
        - operator: Exists
          effect: NoSchedule
      containers:
        - name: generic-device-plugin
          image: {{ cluster_platform_generic_device_plugin_image }}
          args:
            - --domain=homelab.local
            - --device
            - |
              name: coral
              groups:
                - paths:
                    - path: /dev/apex_0
            - --device
            - |
              name: gpu
              groups:
                - paths:
                    - path: /dev/dri/renderD128
                    - path: /dev/dri/card0
                    - path: /dev/kfd
          resources:
            requests: { cpu: 50m, memory: 10Mi }
            limits: { cpu: 50m, memory: 20Mi }
          securityContext:
            privileged: true
          volumeMounts:
            - name: device-plugin
              mountPath: /var/lib/kubelet/device-plugins
            - name: dev
              mountPath: /dev
      volumes:
        - name: device-plugin
          hostPath:
            path: /var/lib/kubelet/device-plugins
        - name: dev
          hostPath:
            path: /dev
